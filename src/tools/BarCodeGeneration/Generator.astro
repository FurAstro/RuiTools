---
interface Props { id: string }
const { id } = Astro.props;
---
<div class="barcode-generator" id={id}>
  <div class="generator-grid">
    <form class="panel" novalidate>
      <slot />
      <div class="actions"><button type="submit" class="primary">生成预览</button><button type="reset">恢复默认</button></div>
      <p data-error class="error" role="alert"></p>
    </form>
    <section class="panel" aria-label="生成结果">
      <h2>预览</h2>
      <div class="preview"><img data-preview alt="生成的码图" hidden /><p data-placeholder>输入内容后生成预览</p></div>
      <p data-status class="hint" role="status" aria-live="polite"></p>
      <div class="actions"><button type="button" data-download="png" disabled>下载 PNG</button><button type="button" data-download="svg" disabled>下载 SVG</button></div>
    </section>
  </div>
  <noscript>请启用 JavaScript 后使用生成工具。</noscript>
</div>
<style is:global>
  .barcode-generator { max-width: 1120px; margin-top: 20px; }
  .barcode-generator .intro { color: #626474; margin-bottom: 20px; }
  .barcode-generator .generator-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .barcode-generator .panel { min-width: 0; padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: 14px; }
  .barcode-generator label { display: flex; flex-direction: column; gap: 8px; font-weight: 600; margin-bottom: 18px; }
  .barcode-generator input, .barcode-generator select, .barcode-generator textarea { width: 100%; min-width: 0; padding: 10px 12px; font: inherit; color: inherit; border: 1px solid #d7d9e2; border-radius: 8px; background: #fff; }
  .barcode-generator textarea { resize: vertical; min-height: 130px; }
  .barcode-generator input:focus-visible, .barcode-generator select:focus-visible, .barcode-generator textarea:focus-visible { outline: 2px solid #89951a; outline-offset: 2px; }
  .barcode-generator .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .barcode-generator .check { flex-direction: row; align-items: center; font-weight: 400; }
  .barcode-generator .check input { width: 18px; height: 18px; accent-color: #89951a; }
  .barcode-generator .hint { color: #626474; font-size: 13px; font-weight: 400; overflow-wrap: anywhere; }
  .barcode-generator .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .barcode-generator button { padding: 10px 16px; font: inherit; font-weight: 600; border: 1px solid #d7d9e2; border-radius: 8px; background: #fff; color: inherit; cursor: pointer; }
  .barcode-generator button.primary { background: var(--color-primary); border-color: var(--color-primary); }
  .barcode-generator button:hover:not(:disabled) { filter: brightness(.96); }
  .barcode-generator button:disabled { opacity: .45; cursor: not-allowed; }
  .barcode-generator .error { color: #b42318; margin-bottom: 0; overflow-wrap: anywhere; }
  .barcode-generator .error:empty { display: none; }
  .barcode-generator h2 { font-size: 16px; margin: 0 0 16px; }
  .barcode-generator .preview { min-height: 280px; display: flex; align-items: center; justify-content: center; overflow: auto; background: #f8f9fc; border: 1px dashed #d7d9e2; border-radius: 10px; padding: 16px; }
  .barcode-generator .preview img { display: block; max-width: 100%; height: auto; }
  .barcode-generator .preview p { color: #626474; }
  @media (max-width: 850px) { .barcode-generator .generator-grid { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .barcode-generator .panel { padding: 16px; } .barcode-generator .fields { grid-template-columns: 1fr; gap: 0; } }
</style>

