---
import { Icon } from "astro-icon/components";
import CategoryItem from './CategoryItem.astro';
interface Props {
  categories: { id: string; name: string; icon: string }[];
  tools: { category: string }[];
  activeCategory?: string;
}
const { categories, tools, activeCategory = 'all' } = Astro.props;
---

<aside data-sidebar>
    <button class="sidebar-toggle" type="button" title="折叠侧栏" >
      <span class="icon-close">
        <Icon name="lucide:panel-left-close" size={20} />
      </span>
      <span class="icon-open">
        <Icon name="lucide:panel-left-open" size={20} />
      </span>
    </button>
    <nav id="tool-categories">
      <CategoryItem id="all" name="全部工具" icon="lucide:layout-grid" href="/" count={tools.length} active={activeCategory === 'all'} />
      {categories.map(category => (
        <CategoryItem
          id={category.id}
          name={category.name}
          icon={category.icon}
          href={'/?category=' + encodeURIComponent(category.id)}
          count={tools.filter(tool => tool.category === category.id).length}
          active={activeCategory === category.id}
        />
      ))}
    </nav>
    <small class="version">RuiTools v0.1b</small>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const workspace = sidebar?.closest<HTMLElement>('.workspace');
  const toggle = sidebar?.querySelector<HTMLButtonElement>('.sidebar-toggle');
  const storageKey = 'ruitools-sidebar-collapsed';

  function setCollapsed(collapsed: boolean) {
    if (!sidebar || !workspace || !toggle) return;

    sidebar.dataset.collapsed = String(collapsed);
    workspace.classList.toggle('sidebar-collapsed', collapsed);

    const label = collapsed ? '展开侧栏' : '折叠侧栏';
    toggle.title = label;
  }

  let initiallyCollapsed = false;
  try {
    initiallyCollapsed = localStorage.getItem(storageKey) === 'true';
  } catch {
    // The sidebar still works when storage is unavailable.
  }
  setCollapsed(initiallyCollapsed);

  toggle?.addEventListener('click', () => {
    const collapsed = sidebar?.dataset.collapsed !== 'true';
    setCollapsed(collapsed);
    try {
      localStorage.setItem(storageKey, String(collapsed));
    } catch {
      // Keep the in-page state even when storage is unavailable.
    }
  });
</script>

<style>
  aside {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 64px 12px 12px;
    background: var(--color-background-sidebar);
    border-right: 1px solid var(--color-border-sidebar);
    transition:
      padding-inline 300ms ease,
      border-color 300ms ease;
  }
  .sidebar-toggle {
    position: absolute;
    top: 24px;
    right: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    color: var(--color-text-default-secondary);
    font: inherit;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    cursor: pointer;
    transition:
      right 300ms ease,
      border-radius 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease,
      color 200ms ease,
      background-color 300ms ease;
  }
  .sidebar-toggle:hover {
    color: var(--color-primary);
    background: var(--color-primary-background);
  }
  .sidebar-toggle .icon-close,
  .sidebar-toggle .icon-open {
    flex-shrink: 0;
  }
  .sidebar-toggle .icon-close,
  .sidebar-toggle .icon-open {
    display: flex;
    grid-area: 1 / 1;
    transition: opacity 300ms ease;
  }
  .sidebar-toggle .icon-open {
    opacity: 0;
  }
  aside[data-collapsed="true"] .icon-close {
    opacity: 0;
  }
  aside[data-collapsed="true"] .icon-open {
    opacity: 1;
  }
  aside[data-collapsed="true"] {
    padding-inline: 0;
    border-right-color: transparent;
  }
  aside[data-collapsed="true"] nav,
  aside[data-collapsed="true"] .version {
    visibility: hidden;
    pointer-events: none;
  }
  aside[data-collapsed="true"] .sidebar-toggle {
    right: -40px;
    background: var(--color-background-sidebar);
    border-color: var(--color-border-sidebar);
    border-radius: 0px 8px 8px 0px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
  }
  aside[data-collapsed="true"] .sidebar-toggle:hover {
    background: var(--color-primary-background);
  }
  .nav-heading,
  nav p,
  .version {
    color: var(--color-text-default-secondary);
    font-size: 12px;
  }
  .nav-heading,
  nav p {
    padding: 0 12px;
  }
  nav p {
    margin-top: 28px;
  }
  .version {
    margin-top: auto;
    padding: 30px 12px 0;
  }
</style>

