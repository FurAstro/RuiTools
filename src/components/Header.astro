---
import { Icon } from "astro-icon/components";
---

<header>
  <a class="brand" href={import.meta.env.BASE_URL}>
    <span class="icon-box"><Icon name="lucide:blocks" size={24} /></span>
    <strong>Rui<span class="text">Tools</span></strong>
  </a>
  <a class="home-link" href={import.meta.env.BASE_URL}>
    <Icon name="lucide:house" size={20} />
    首页
  </a>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 32px;
    background: var(--color-background-header);
    border-bottom: 1px solid var(--color-border-header);
  }
  .brand {
    font-size: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .icon-box {
    display: grid;
    place-items: center;
    background: var(--color-primary);
    color: var(--color-background-header);
    width: 38px;
    height: 38px;
    border-radius: 12px;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 200ms ease;
  }
  .home-link:hover {
    color: var(--color-primary);
    transition: color 200ms ease;
  }
  .text {
    color: var(--color-primary);
  }
</style>
